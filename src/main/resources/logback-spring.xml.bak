<configuration>

    <!-- JSON encoder snippet -->
    <springProperty scope="context" name="LOG_DIR" source="LOG_DIR" defaultValue="logs" />

    <!-- Console appender -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <pattern>
                    <pattern>{"level":"%level"}</pattern>
                </pattern>
                <pattern>
                    <pattern>{"logger":"%logger"}</pattern>
                </pattern>
                <pattern>
                    <pattern>{"thread":"%thread"}</pattern>
                </pattern>
                <pattern>
                    <pattern>{"traceId":"%X{traceId:-}","spanId":"%X{spanId:-}"}</pattern>
                </pattern>
                <pattern>
                    <pattern>{"message":"%replace(%msg){'\n','\\\\n'}"}</pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <!-- File appender with daily + size-based rolling -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/notification_app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/notification_app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <pattern>
                    <pattern>{"level":"%level"}</pattern>
                </pattern>
                <pattern>
                    <pattern>{"logger":"%logger"}</pattern>
                </pattern>
                <pattern>
                    <pattern>{"thread":"%thread"}</pattern>
                </pattern>
                <pattern>
                    <pattern>{"traceId":"%X{traceId:-}","spanId":"%X{spanId:-}"}</pattern>
                </pattern>
                <pattern>
                    <pattern>{"message":"%replace(%msg){'\n','\\\\n'}"}</pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <!-- Local/Dev: Console + File -->
    <springProfile name="dev,local">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>

    <!-- Prod: Console only -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

</configuration>
